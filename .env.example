# Where the browser sends API requests.
# Keep the default (/api/v1) to use the Vite dev/preview proxy below, or set a
# full URL (e.g. https://api.example.com/api/v1) when the API is hosted elsewhere.
# If you use a full URL, add this site's origin to the backend's CORS_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Backend address used by the dev/preview proxy (`npm run dev`, `npm run preview`).
VITE_API_PROXY_TARGET=http://localhost:3000

# How often the quote panel polls while the tab is visible (milliseconds).
VITE_QUOTE_POLL_MS=60000
