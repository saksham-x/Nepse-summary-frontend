{
  "name": "nepse-summary-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Charting frontend for the nepse-api backend",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
